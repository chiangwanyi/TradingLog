# 复制为 .env 后按需修改：cp .env.example .env
# 每一项都可以被同名环境变量覆盖；未设置的项使用 src/app/core/config.py 中的默认值。

# ---- 基础信息 ----
APP_NAME=TradingLog API
APP_VERSION=0.1.0
DEBUG=false

# ---- 服务监听（uv run tradinglog-server 会读取这两项）----
HOST=127.0.0.1
PORT=8000
# 开发时设为 true，代码改动自动重载
RELOAD=true

# ---- 路由前缀 ----
API_V1_PREFIX=/api/v1

# ---- 跨域：允许访问的前端来源（注意是 JSON 数组格式）----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
